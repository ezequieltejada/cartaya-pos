// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "CartaYa POS - Ionic",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
	"features": {
		"ghcr.io/devcontainers-extra/features/ionic-cli:2": {},
		"ghcr.io/devcontainers/features/java:1.8.3": {
			"version": "21"
		},
		"ghcr.io/tailscale/codespace/tailscale": {
			"version": "latest"
		}
	},

	// Tailscale needs these to create its tun interface inside the container.
	"runArgs": [
		"--cap-add=net_admin",
		"--cap-add=net_raw",
		"--device=/dev/net/tun"
	],

	// Joins the tailnet and serves the dev server (port 8100) over HTTPS, then
	// points agent-browser at the host's Chromium (CDP) and registers its MCP server.
	"postStartCommand": "bash .devcontainer/start-tailscale.sh; bash .devcontainer/setup-agent-browser.sh",

	"shutdownAction": "stopContainer",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "yarn install",

	// Configure tool-specific properties.
	// "customizations": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"usernamehw.errorlens",
				"mutantdino.resourcemonitor",
				"anaer.git-user-profiles-config",
				"alefragnani.separators",
				"webnative.webnative"
			]
		}
	},
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached"
	]

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
